        <object label="Tag rush" quodsiType="Activity" quodsiTracked="true" quodsiData='{"id":"act-tagrush","name":"Tag rush","capacity":1,"inboundQueueCapacity":999999,"outboundQueueCapacity":999999,"actions":[{"id":"act-tagrush-assign","actionType":"ASSIGN","stateModifications":[{"stateUniqueId":"st-rush","stateName":"rush","operation":"=","value":1}]},{"id":"act-tagrush-delay","actionType":"DELAY_WITH_RESOURCE","duration":{"durationPeriodUnit":"MINUTES","distribution":{"distributionType":"constant","parameters":{"value":1},"description":""}},"resourceRequirementId":null,"keepResource":false,"stateModifications":[],"stateCondition":null}],"connectType":"Probability","financialProperties":{"enabled":false,"fixedCost":0,"costPerEntityProcessed":0,"costPerHourActive":0,"costPerHourIdle":0,"resourceCostMultiplier":1},"failureProperties":{"enabled":false,"mtbfDuration":null,"mttrDuration":null,"failureClockMode":"WALL_CLOCK","repairResourceRequirementId":""}}' id="act-tagrush">
