{
  "schemaVersion": "2026.12.01",
  "name": "Dispose: scrap a bad part at inspection",
  "replications": 1,
  "seed": 1,
  "timeUnit": "minutes",
  "runTime": { "unit": "minutes", "value": 60 },
  "entities": [ { "id": "part", "name": "Part" } ],
  "resources": [],
  "resourceRequirements": [],
  "activities": [
    { "id": "inspect", "name": "Inspect Part",
      "actions": [
        { "id": "inspect-delay", "type": "delay", "duration": { "unit": "minutes", "value": 1.0 } },
        { "id": "scrap-if-defective", "type": "dispose",
          "condition": { "stateId": "state-defective", "comparison": "equal", "value": 1 } }
      ] },
    { "id": "pack", "name": "Pack Part",
      "actions": [ { "id": "pack-delay", "type": "delay", "duration": { "unit": "minutes", "value": 2.0 } } ] }
  ],
  "generators": [
    { "id": "good-parts", "name": "Good Parts", "entityId": "part",
      "interarrivalTime": { "unit": "minutes", "value": 5.0 }, "maxEntities": 3 },
    { "id": "bad-parts", "name": "Bad Parts", "entityId": "part",
      "interarrivalTime": { "unit": "minutes", "value": 5.0 }, "startDelay": { "unit": "minutes", "value": 7.0 }, "maxEntities": 1,
      "initialStates": [ { "stateId": "state-defective", "operation": "assign", "value": 1 } ] }
  ],
  "connectors": [
    { "id": "edge-good-inspect", "sourceId": "good-parts", "targetId": "inspect" },
    { "id": "edge-bad-inspect", "sourceId": "bad-parts", "targetId": "inspect" },
    { "id": "edge-inspect-pack", "sourceId": "inspect", "targetId": "pack" }
  ],
  "states": [
    { "id": "state-defective", "name": "defective", "componentType": "entity", "dataType": "number", "initialValue": 0 }
  ]
}
