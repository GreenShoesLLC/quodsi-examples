          </mxCell>
        </object>
        <object label="Manager Approval" quodsiType="Activity" quodsiTracked="true" quodsiData="{&quot;id&quot;:&quot;approval&quot;,&quot;name&quot;:&quot;Manager Approval&quot;,&quot;actions&quot;:[{&quot;id&quot;:&quot;approval-delay&quot;,&quot;type&quot;:&quot;delay&quot;,&quot;duration&quot;:{&quot;unit&quot;:&quot;minutes&quot;,&quot;value&quot;:3}}],&quot;x&quot;:432,&quot;y&quot;:12}" id="approval">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1">
            <mxGeometry height="80" width="80" x="432" y="62" as="geometry" />
