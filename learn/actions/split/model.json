{
  "schemaVersion": "2026.12.01",
  "name": "Split: one entity becomes three",
  "replications": 1,
  "seed": 1,
  "timeUnit": "minutes",
  "runTime": {
    "unit": "minutes",
    "value": 60
  },
  "entities": [
    {
      "id": "order",
      "name": "Order"
    }
  ],
  "resources": [],
  "resourceRequirements": [],
  "activities": [
    {
      "id": "split-order",
      "name": "Split Order",
      "actions": [
        {
          "id": "split-order-delay",
          "type": "delay",
          "duration": {
            "unit": "minutes",
            "value": 1.0
          }
        },
        {
          "id": "split-order-split",
          "type": "split",
          "count": 3,
          "destinationId": "dispatch",
          "splitIndexState": "piece_index",
          "modifications": []
        }
      ]
    },
    {
      "id": "dispatch",
      "name": "Dispatch",
      "routing": "state_condition",
      "actions": []
    },
    {
      "id": "pack-a",
      "name": "Pack Item A",
      "actions": [
        {
          "id": "pack-a-delay",
          "type": "delay",
          "duration": {
            "unit": "minutes",
            "value": 2.0
          }
        }
      ]
    },
    {
      "id": "pack-b",
      "name": "Pack Item B",
      "actions": [
        {
          "id": "pack-b-delay",
          "type": "delay",
          "duration": {
            "unit": "minutes",
            "value": 4.0
          }
        }
      ]
    },
    {
      "id": "pack-c",
      "name": "Pack Item C",
      "actions": [
        {
          "id": "pack-c-delay",
          "type": "delay",
          "duration": {
            "unit": "minutes",
            "value": 6.0
          }
        }
      ]
    }
  ],
  "generators": [
    {
      "id": "order-arrives",
      "name": "Order Arrives",
      "entityId": "order",
      "interarrivalTime": {
        "unit": "minutes",
        "value": 1.0
      },
      "maxEntities": 1
    }
  ],
  "connectors": [
    {
      "id": "edge-arrive-split",
      "sourceId": "order-arrives",
      "targetId": "split-order"
    },
    {
      "id": "edge-dispatch-a",
      "sourceId": "dispatch",
      "targetId": "pack-a",
      "entityId": "order",
      "condition": {
        "stateId": "state-piece-index",
        "comparison": "equal",
        "value": 0
      }
    },
    {
      "id": "edge-dispatch-b",
      "sourceId": "dispatch",
      "targetId": "pack-b",
      "entityId": "order",
      "condition": {
        "stateId": "state-piece-index",
        "comparison": "equal",
        "value": 1
      }
    },
    {
      "id": "edge-dispatch-c",
      "sourceId": "dispatch",
      "targetId": "pack-c",
      "entityId": "order",
      "condition": {
        "stateId": "state-piece-index",
        "comparison": "equal",
        "value": 2
      }
    }
  ],
  "states": [
    {
      "id": "state-piece-index",
      "name": "piece_index",
      "componentType": "entity",
      "dataType": "number",
      "initialValue": 0
    }
  ]
}
