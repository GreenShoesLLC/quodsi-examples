        </object>
        <object label="" quodsiType="Connector" quodsiTracked="true" quodsiData="{&quot;id&quot;:&quot;edge-take-pack&quot;,&quot;sourceId&quot;:&quot;take-order&quot;,&quot;targetId&quot;:&quot;pack-order&quot;,&quot;weight&quot;:1,&quot;name&quot;:&quot;Take Order → Pack Order&quot;}" id="edge-take-pack">
          <mxCell edge="1" parent="1" source="take-order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="pack-order">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object label="Order Arrives" quodsiType="Generator" quodsiTracked="true" quodsiData="{&quot;id&quot;:&quot;order-arrives&quot;,&quot;name&quot;:&quot;Order Arrives&quot;,&quot;entityId&quot;:&quot;order&quot;,&quot;interarrivalTime&quot;:{&quot;unit&quot;:&quot;minutes&quot;,&quot;value&quot;:1},&quot;maxEntities&quot;:1,&quot;x&quot;:12,&quot;y&quot;:36}" id="order-arrives">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1">
            <mxGeometry height="80" width="80" x="12" y="86" as="geometry" />
          </mxCell>
        </object>
        <object label="Take Order" quodsiType="Activity" quodsiTracked="true" quodsiData="{&quot;id&quot;:&quot;take-order&quot;,&quot;name&quot;:&quot;Take Order&quot;,&quot;actions&quot;:[{&quot;id&quot;:&quot;take-order-delay&quot;,&quot;type&quot;:&quot;delay&quot;,&quot;duration&quot;:{&quot;unit&quot;:&quot;minutes&quot;,&quot;value&quot;:1}},{&quot;id&quot;:&quot;create-invoice&quot;,&quot;type&quot;:&quot;create&quot;,&quot;entityTemplateId&quot;:&quot;invoice&quot;,&quot;destinationId&quot;:&quot;print-invoice&quot;,&quot;modifications&quot;:[]},{&quot;id&quot;:&quot;create-label&quot;,&quot;type&quot;:&quot;create&quot;,&quot;entityTemplateId&quot;:&quot;shipping-label&quot;,&quot;destinationId&quot;:&quot;print-label&quot;,&quot;modifications&quot;:[]},{&quot;id&quot;:&quot;create-slip&quot;,&quot;type&quot;:&quot;create&quot;,&quot;entityTemplateId&quot;:&quot;packing-slip&quot;,&quot;destinationId&quot;:&quot;print-slip&quot;,&quot;modifications&quot;:[]}],&quot;x&quot;:152,&quot;y&quot;:36}" id="take-order">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1">
            <mxGeometry height="80" width="80" x="152" y="86" as="geometry" />
          </mxCell>
        </object>
        <object label="Pack Order" quodsiType="Activity" quodsiTracked="true" quodsiData="{&quot;id&quot;:&quot;pack-order&quot;,&quot;name&quot;:&quot;Pack Order&quot;,&quot;actions&quot;:[{&quot;id&quot;:&quot;pack-order-delay&quot;,&quot;type&quot;:&quot;delay&quot;,&quot;duration&quot;:{&quot;unit&quot;:&quot;minutes&quot;,&quot;value&quot;:5}}],&quot;x&quot;:292,&quot;y&quot;:12}" id="pack-order">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1">
