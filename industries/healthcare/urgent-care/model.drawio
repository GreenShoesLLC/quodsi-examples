;Imaging Tech&quot;,&quot;capacity&quot;:1,&quot;financialProperties&quot;:{&quot;enabled&quot;:true,&quot;costPerSeize&quot;:0,&quot;costPerHourUtilized&quot;:30,&quot;costPerHourIdle&quot;:30}}],&quot;levers&quot;:[],&quot;model&quot;:{&quot;id&quot;:&quot;drawio-model&quot;,&quot;name&quot;:&quot;Urgent Care Clinic — Patient Flow, Simple (Discrete Event Simulation)&quot;,&quot;replications&quot;:10,&quot;seed&quot;:12345,&quot;timeUnit&quot;:&quot;minutes&quot;,&quot;timeMode&quot;:&quot;clock&quot;,&quot;warmupTime&quot;:{&quot;unit&quot;:&quot;hours&quot;,&quot;value&quot;:0},&quot;runTime&quot;:{&quot;unit&quot;:&quot;hours&quot;,&quot;value&quot;:12},&quot;warmupDateTime&quot;:null,&quot;startDateTime&quot;:null,&quot;finishDateTime&quot;:null,&quot;levers&quot;:[]},&quot;resourceRequirements&quot;:[{&quot;id&quot;:&quot;00cbf522-1cc8-445c-85ab-4b6c5d7b9610&quot;,&quot;name&quot;:&quot;Front Desk Staff&quot;,&quot;rootClause&quot;:{&quot;id&quot;:&quot;clause-1&quot;,&quot;mode&quot;:&quot;require_all&quot;,&quot;requests&quot;:[{&quot;resourceId&quot;:&quot;00cbf522-1cc8-445c-85ab-4b6c5d7b9610&quot;}]}},{&quot;id&quot;:&quot;9f306708-169f-4481-8bf1-c7c681e118e4&quot;,&quot;name&quot;:&quot;Triage Nurse&quot;,&quot;rootClause&quot;:{&quot;id&quot;:&quot;clause-1&quot;,&quot;mode&quot;:&quot;require_all&quot;,&quot;requests&quot;:[{&quot;resourceId&quot;:&quot;9f306708-169f-4481-8bf1-c7c681e118e4&quot;}]}},{&quot;id&quot;:&quot;222f5ce9-6846-4785-81ed-a5798af7e42f&quot;,&quot;name&quot;:&quot;Provider&quot;,&quot;rootClause&quot;:{&quot;id&quot;:&quot;clause-1&quot;,&quot;mode&quot;:&quot;require_all&quot;,&quot;requests&quot;:[{&quot;resourceId&quot;:&quot;222f5ce9-6846-4785-81ed-a5798af7e42f&quot;}]}},{&quot;id&quot;:&quot;ebba11d3-cbb9-45e0-9258-7c9b61043a3e&quot;,&quot;name&quot;:&quot;Lab Tech&quot;,&quot;rootClause&quot;:{&quot;id&quot;:&quot;clause-1&quot;,&quot;mode&quot;:&quot;require_all&quot;,&quot;requests&quot;:[{&quot;resourceId&quot;:&quot;ebba11d3-cbb9-45e0-9258-7c9b61043a3e&quot;}]}},{&quot;id&quot;:&quot;df795681-54ec-4009-88c1-dcc83e72cf02&quot;,&quot;name&quot;:&quot;Imaging Tech&quot;,&quot;rootClause&quot;:{&quot;id&quot;:&quot;clause-1&quot;,&quot;mode&quot;:&quot;require_all&quot;,&quot;requests&quot;:[{&quot;resourceId&quot;:&quot;df795681-54ec-4009-88c1-dcc83e72cf02&quot;}]}}],&quot;name&quot;:&quot;Urgent Care Clinic — Patient Flow, Simple (Discrete Event Simulation)&quot;,&quot;startDateTime&quot;:null,&quot;warmupDateTime&quot;:null,&quot;finishDateTime&quot;:null,&quot;workSchedules&quot;:[],&quot;arrivalPatterns&quot;:[],&quot;schemaVersion&quot;:&quot;2026.12.01&quot;}" id="0">
